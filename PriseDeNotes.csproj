<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PriseDeNotes</RootNamespace>
    <AssemblyName>PriseDeNotes</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Version>1.0.0</Version>
    <Authors>Louis Jean-Thierry</Authors>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\AppIcon.ico" LogicalName="PriseDeNotes.AppIcon.ico" />
  </ItemGroup>

  <!-- Le projet de tests vit dans un sous-dossier : l'application ne doit pas compiler ses fichiers. -->
  <ItemGroup>
    <Compile Remove="PriseDeNotes.Tests\**" />
    <EmbeddedResource Remove="PriseDeNotes.Tests\**" />
    <None Remove="PriseDeNotes.Tests\**" />
    <InternalsVisibleTo Include="PriseDeNotes.Tests" />
  </ItemGroup>

</Project>
